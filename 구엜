# words.txt 전체 단어 목록을 메모리에 로드
def load_all_words():
    if not os.path.exists(WORDS_TXT_PATH):
        print(f"❌ [에러] '{WORDS_TXT_PATH}' 파일을 찾을 수 없습니다!")
        return set()

    for encoding in ['utf-8', 'cp949', 'euc-kr']:
        try:
            with open(WORDS_TXT_PATH, 'r', encoding=encoding) as f:
                words = {line.strip() for line in f if line.strip()}
            return words
        except UnicodeDecodeError:
            continue
    return set()

