def format_mode1_history(history, p1_id):
    res = []
    for item in history:
        w = item['word']
        if item['player'] == p1_id:
            res.append(f"({w})")
        else:
            res.append(f"[{w}]")
    return " -> ".join(res)

async def finish_mode3_game(channel, game):
    sorted_scores = sorted(game['scores'].items(), key=lambda x: x[1], reverse=True)
    res = "🏆 **자음·모음 비중복 게임 결과 발표**\n"
    for idx, (p_id, sc) in enumerate(sorted_scores):
        res += f"{idx + 1}위: <@{p_id}> - {sc}점\n"
    
    if channel.id in mode3_games:
        del mode3_games[channel.id]
    await channel.send(res)

async def send_next_quiz(channel, quiz_state):
    q = quiz_state['questions'][quiz_state['current_index']]
    joined_inc = "', '".join(q['includes'])
    inc_text = f"'{joined_inc}'가 포함" if q['includes'] else "포함 조건 없음"
    await channel.send(
        f"❓ **퀴즈 [{quiz_state['current_index'] + 1}/{quiz_state['total']}]**\n"
        f"'**{q['first_char']}**'로 시작하고 **{inc_text}** 되어 있는 단어는?"
    )

async def send_next_quiz4(channel, quiz_state):
    q = quiz_state['questions'][quiz_state['current_index']]
    cond_str = ", ".join([f"'{char}' {cnt}개" for char, cnt in q['counts'].items()])
    inc_text = cond_str if cond_str else "포함 조건 없음"
    await channel.send(
        f"❓ **4퀴즈 [{quiz_state['current_index'] + 1}/{quiz_state['total']}]**\n"
        f"'**{q['first_char']}**'로 시작하고 **{inc_text}**인 단어는?"
    )

