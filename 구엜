# 게임 종료 처리 함수
async def finish_game(channel, game, reason_title="🏁 게임 종료!"):
    game.is_active = False
    
    # 점수 정렬
    sorted_scores = sorted(game.scores.items(), key=lambda x: x[1], reverse=True)
    winner_id, top_score = sorted_scores[0]
    winner = next(p for p in game.players if p.id == winner_id)

    # 리더보드 텍스트 생성
    leaderboard = ""
    for rank, (p_id, score) in enumerate(sorted_scores, 1):
        p_name = next(p.display_name for p in game.players if p.id == p_id)
        leaderboard += f"**{rank}위**: {p_name} ({score}점)\n"

    # 전체 기보 텍스트 생성
    full_history = " ➔ ".join(game.chain_history)
    if len(full_history) > 1000:
        full_history = full_history[:970] + " ... (생략)"

    embed = discord.Embed(
        title=reason_title,
        description=f"🎉 **최종 승리자: {winner.mention} ({top_score}점)**",
        color=discord.Color.gold()
    )
    embed.add_field(name="📊 최종 점수 순위", value=leaderboard, inline=False)
    embed.add_field(name="📜 전체 기보", value=f"```\n{full_history}\n```", inline=False)

    await channel.send(embed=embed)
    del active_games[channel.id]

# 퀴즈 출제 함수
async def send_next_quiz(channel, quiz):
    words2 = list(load_words2())
    if not words2:
        await channel.send("❌ 'words2.txt' 단어장에 단어가 없습니다!")
        del active_quizzes[channel.id]
        return

    quiz.current_question += 1
    target_word = random.choice(words2)
    quiz.target_word = target_word

    GA_HA = {'가', '나', '다', '라', '마', '바', '사', '아', '자', '차', '카', '타', '파', '하'}
    first_char = target_word[0]
    req_ga_ha = set(c for c in target_word[1:] if c in GA_HA)

    valid = []
    for w in words2:
        if w[0] == first_char and req_ga_ha.issubset(set(w[1:])):
            valid.append(w)

    quiz.valid_answers = valid
    quiz.hint_text = quiz.generate_hint(target_word)

    embed = discord.Embed(
        title=f"❓ 퀴즈 문제 ({quiz.current_question}/{quiz.total_questions})",
        description=f"**힌트**: {quiz.hint_text}",
        color=discord.Color.blue()
    )
    await channel.send(embed=embed)

