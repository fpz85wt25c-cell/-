# 메모리 절약을 위해 필요할 때만 불러오는 지연 로딩 (Lazy Loading) 함수
def load_words_lazy(file_name):
    if not os.path.exists(file_name):
        print(f"[경고] {file_name} 파일이 존재하지 않습니다.")
        return set()
    words = set()
    with open(file_name, "r", encoding="utf-8") as f:
        for line in f:
            w = line.strip()
            if w:
                words.add(w)
    return words

# 기본 시작 시에는 꼭 필요한 단어장만 로드하거나 필요 시 로드하도록 캐시 구조 적용
WORD_CACHE = {}

def get_word_set(file_name):
    if file_name not in WORD_CACHE:
        WORD_CACHE[file_name] = load_words_lazy(file_name)
    return WORD_CACHE[file_name]

STATS_FILE = "stats.json"
user_stats = {}
if os.path.exists(STATS_FILE):
    try:
        with open(STATS_FILE, "r", encoding="utf-8") as f:
            user_stats = json.load(f)
    except Exception:
        user_stats = {}

def save_stats():
    with open(STATS_FILE, "w", encoding="utf-8") as f:
        json.dump(user_stats, f, ensure_ascii=False, indent=2)

def record_game_result(winner_id, loser_id):
    w_id, l_id = str(winner_id), str(loser_id)
    if w_id not in user_stats:
        user_stats[w_id] = {"win": 0, "lose": 0}
    if l_id not in user_stats:
        user_stats[l_id] = {"win": 0, "lose": 0}
    
    user_stats[w_id]["win"] += 1
    user_stats[l_id]["lose"] += 1
    save_stats()

DOUBLE_JONG_MAP = {
    'ㄳ': ['ㄱ', 'ㅅ'], 'ㄵ': ['ㄴ', 'ㅈ'], 'ㄶ': ['ㄴ', 'ㅎ'],
    'ㄺ': ['ㄹ', 'ㄱ'], 'ㄻ': ['ㄹ', 'ㅁ'], 'ㄼ': ['ㄹ', 'ㅂ'],
    'ㄽ': ['ㄹ', 'ㅅ'], 'ㄾ': ['ㄹ', 'ㅌ'], 'ㄿ': ['ㄹ', 'ㅍ'],
    'ㅀ': ['ㄹ', 'ㅎ'], 'ㅄ': ['ㅂ', 'ㅅ']
}

def extract_jamo_set(word):
    jamo_set = set()
    for char in word:
        if hgtk.checker.is_hangul(char):
            cho, jo, jong = hgtk.letter.decompose(char)
            jamo_set.add(cho)
            jamo_set.add(jo)
            if jong:
                if jong in DOUBLE_JONG_MAP:
                    jamo_set.update(DOUBLE_JONG_MAP[jong])
                else:
                    jamo_set.add(jong)
        else:
            jamo_set.add(char)
    return jamo_set

def get_possible_first_syllables(syllable):
    if not hgtk.checker.is_hangul(syllable):
        return [syllable]
    
    if syllable.startswith("러"):
        return ["러"]

    cho, jo, jong = hgtk.letter.decompose(syllable)
    possible = [syllable]

    if cho == 'ㄹ' and jo in ['ㅏ', 'ㅐ', 'ㅗ', 'ㅚ', 'ㅜ', 'ㅡ']:
        possible.append(hgtk.letter.compose('ㄴ', jo, jong))

    if cho == 'ㄹ' and jo in ['ㅑ', 'ㅕ', 'ㅖ', 'ㅛ', 'ㅠ', 'ㅣ']:
        possible.append(hgtk.letter.compose('ㅇ', jo, jong))

    if cho == 'ㄴ' and jo in ['ㅕ', 'ㅛ', 'ㅠ', 'ㅣ']:
        possible.append(hgtk.letter.compose('ㅇ', jo, jong))

    return list(set(possible))

def can_connect_word(prev_word, next_word):
    if not prev_word:
        return True
    last_char = prev_word[-1]
    allowed_starts = get_possible_first_syllables(last_char)
    return next_word[0] in allowed_starts

def is_one_shot_word(word, word_dict):
    last_char = word[-1]
    allowed_starts = get_possible_first_syllables(last_char)
    for w in word_dict:
        if w[0] in allowed_starts:
            return False
    return True

GA_HA_CHARS = ['가','나','다','라','마','바','사','아','자','차','카','타','파','하']

def count_next_words_words4(word, words4_set):
    last_char = word[-1]
    allowed_starts = get_possible_first_syllables(last_char)
    # 메모리 절약을 위해 필요할 때만 조건 검사
    return sum(1 for w in words4_set if w and w[0] in allowed_starts)

def sort_words4_list(word_list, words4_set):
    def sort_key(w):
        mission_count = sum(w.count(gh) for gh in GA_HA_CHARS)
        next_count = count_next_words_words4(w, words4_set)
        return (-mission_count, next_count)
        
    return sorted(word_list, key=sort_key)

mode1_lobby = {}
