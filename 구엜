# 겹받침 분리용 매핑 테이블
DOUBLE_FINAL_CONSONANTS = {
    'ㄳ': ['ㄱ', 'ㅅ'],
    'ㄵ': ['ㄴ', 'ㅈ'],
    'ㄶ': ['ㄴ', 'ㅎ'],
    'ㄺ': ['ㄹ', 'ㄱ'],
    'ㄻ': ['ㄹ', 'ㅁ'],
    'ㄼ': ['ㄹ', 'ㅂ'],
    'ㄽ': ['ㄹ', 'ㅅ'],
    'ㄾ': ['ㄹ', 'ㅌ'],
    'ㄿ': ['ㄹ', 'ㅍ'],
    'ㅀ': ['ㄹ', 'ㅎ'],
    'ㅄ': ['ㅂ', 'ㅅ']
}

# 초성/종성 호환 매핑 테이블 (초성 자모를 표준 호환 자음으로 일치)
JAMO_COMPATIBILITY_MAP = {
    'ᄀ': 'ㄱ', 'ᄁ': 'ㄲ', 'ᄂ': 'ㄴ', 'ᄃ': 'ㄷ', 'ᄄ': 'ㄸ',
    'ᄅ': 'ㄹ', 'ᄆ': 'ㅁ', 'ᄇ': 'ㅂ', 'ᄈ': 'ㅃ', 'ᄉ': 'ㅅ',
    'ᄊ': 'ㅆ', 'ᄋ': 'ㅇ', 'ᄌ': 'ㅈ', 'ᄍ': 'ㅉ', 'ᄎ': 'ㅊ',
    'ᄏ': 'ㅋ', 'ᄐ': 'ㅌ', 'ᄑ': 'ㅍ', 'ᄒ': 'ㅎ'
}

# 자음/모음(음소) 분리 함수 (초성/종성 구분 없이 완전 통일)
def extract_phonemes(text):
    phonemes = set()
    for char in text:
        if '가' <= char <= '힣':
            # 한글 글자를 자모 분리 후 호환 자모로 변환
            jamo_str = j2hcj(hangul_to_jamo(char))
            for j in jamo_str:
                # 초성 자모 표기가 섞인 경우 일반 자음으로 변환
                mapped_j = JAMO_COMPATIBILITY_MAP.get(j, j)
                if mapped_j in DOUBLE_FINAL_CONSONANTS:
                    for split_j in DOUBLE_FINAL_CONSONANTS[mapped_j]:
                        phonemes.add(split_j)
                else:
                    phonemes.add(mapped_j)
        else:
            # 낱글자 자음('ㄷ' 등) 또는 기타 문자
            mapped_char = JAMO_COMPATIBILITY_MAP.get(char, char)
            if mapped_char in DOUBLE_FINAL_CONSONANTS:
                for split_j in DOUBLE_FINAL_CONSONANTS[mapped_char]:
                    phonemes.add(split_j)
            else:
                phonemes.add(mapped_char)
    return phonemes

# 음소 비중복 검사
def check_no_overlap(prev_word, curr_word):
    prev_phonemes = extract_phonemes(prev_word)
    curr_phonemes = extract_phonemes(curr_word)
    return len(prev_phonemes.intersection(curr_phonemes)) == 0

# 게임 상태 클래스
class GameState:
    def __init__(self, host, mode="normal"):
        self.host = host  # 방장
        self.players = [host]  # 참가자 목록
        self.current_turn_index = 0  # 현재 차례 플레이어 인덱스
        self.scores = {host.id: 0}  # 유저별 점수
        self.bonus_tracker = {host.id: 0}  # 유저별 보너스 연승 수
        self.chain_history = []  # 기보 (사용한 단어 목록)
        self.max_chains = 0  # n * 50
        self.surrender_min_chains = 0  # n * 5
        self.is_started = False
        self.is_active = True
        self.is_test_mode = False  # 테스트 모드 여부
        self.mode = mode  # 게임 모드 구분 ('normal', 'mode1' 등)

    def get_current_player(self):
        return self.players[self.current_turn_index]

    def next_turn(self):
        self.current_turn_index = (self.current_turn_index + 1) % len(self.players)

# 퀴즈 상태 클래스
class QuizState:
    def __init__(self, total_questions, host):
        self.total_questions = total_questions
        self.current_question = 0
        self.host = host
        self.target_word = ""
        self.valid_answers = []
        self.hint_text = ""

    def generate_hint(self, word):
        GA_HA = {'가', '나', '다', '라', '마', '바', '사', '아', '자', '차', '카', '타', '파', '하'}
        first_char = word[0]
        # 첫 음절을 제외한 글자 중 '가~하'에 속하는 음절만 추출
        target_chars = [c for c in word[1:] if c in GA_HA]
        
        # 중복 제거 및 원래 단어 등장 순서 유지
        seen = set()
        ordered_chars = []
        for c in target_chars:
            if c not in seen:
                seen.add(c)
                ordered_chars.append(c)

        if ordered_chars:
            chars_str = ", ".join([f"'{c}'" for c in ordered_chars])
            return f"'{first_char}'(으)로 시작하고 {chars_str}이(가) 포함된 단어"
        else:
            return f"'{first_char}'(으)로 시작하는 단어"

