            game.bonus_tracker[message.author.id] = 0
            player_list = ", ".join([p.display_name for p in game.players])
            await message.channel.send(f"✅ **{message.author.display_name}**님이 참가하셨습니다! (현재 참가자: {player_list})")
        return

    # 4. [3시작] 게임 시작
    if content == "3시작":
        if channel_id not in active_games:
            await message.channel.send("⚠️ 먼저 **`3참가`**로 방을 만들어주세요!")
            return
        
        game = active_games[channel_id]
        if game.host != message.author:
            await message.channel.send("⚠️ 방장만 게임을 시작할 수 있습니다!")
            return
        if game.is_started:
            await message.channel.send("⚠️ 이미 게임이 진행 중입니다!")
            return

        n = len(game.players)
        game.max_chains = n * 50
        game.surrender_min_chains = n * 5
        game.is_started = True

        # 첫 제시 단어 지정 (words.txt에서 무작위 추출)
        initial_word = get_random_word()
        game.chain_history.append(initial_word)

        player_names = ", ".join([p.display_name for p in game.players])
        first_turn_player = game.get_current_player()

        embed = discord.Embed(
            title="🎮 게임 시작!",
            description=f"**참여자 ({n}명):** {player_names}\n"
                        f"**목표 체인:** {game.max_chains}체인\n"
                        f"**종료 가능 체인:** {game.surrender_min_chains}체인 이상부터\n"
                        f"👉 **첫 번째 차례:** {first_turn_player.mention}",
            color=discord.Color.green()
        )
        embed.add_field(name="📌 첫 제시어", value=f"**`{initial_word}`**", inline=False)
        await message.channel.send(embed=embed)
        return

    # 5. [3종료] 정상 게임 종료 신청 (구 3기권 기능)
    if content == "3종료":
        if channel_id not in active_games or not active_games[channel_id].is_started:
            await message.channel.send("⚠️ 진행 중인 게임이 없습니다.")
            return

        game = active_games[channel_id]
        if message.author not in game.players:
            await message.channel.send("⚠️ 게임 참가자만 사용할 수 있습니다.")
            return

        # 자기 턴 검사 (본인 차례에서만 명령어 수행)
        if message.author != game.get_current_player():
            return

        current_chains = len(game.chain_history) - 1
        
        # n * 5체인 미만 시 종료 불가능
        if current_chains < game.surrender_min_chains:
            await message.channel.send(
                f"🛑 아직 종료할 수 없습니다! 최소 **{game.surrender_min_chains}체인**에 도달해야 종료할 수 있습니다. "
                f"(현재: {current_chains}체인)"
            )
            return

        # 종료 성공 -> 현 점수 최고점자 승리로 종료
        await message.channel.send(f"🏁 **{message.author.display_name}**님이 게임 종료를 요청했습니다!")
        await finish_game(message.channel, game, reason_title="🏁 게임 종료!")
        return

    # 6. [3기권] 게임 방 즉시 취소/강제 기권 (구 3종료 기능)
    if content == "3기권":
        if channel_id not in active_games:
            await message.channel.send("⚠️ 현재 진행 중이거나 대기 중인 게임이 없습니다.")
            return

        game = active_games[channel_id]
        if message.author not in game.players:
            await message.channel.send("⚠️ 게임 참가자만 사용할 수 있습니다.")
            return

        # 게임 시작 후라면 자기 턴에서만 실행 가능
        if game.is_started and message.author != game.get_current_player():
            return

        del active_games[channel_id]
        await message.channel.send(f"🏳️ **{message.author.display_name}**님이 게임을 기권(취소)하여 **게임이 강제 종료되었습니다.**")
        return

    # --- 퀴즈 답안 감지 ---
    if channel_id in active_quizzes:
        quiz = active_quizzes[channel_id]
        
        # '패스' 입력 시 기권 및 정답 공개
        if content == "패스":
            answers_str = ", ".join([f"`{a}`" for a in quiz.valid_answers])
            embed = discord.Embed(
                title="💡 정답 공개!",
                description=f"**{message.author.mention}**님이 패스하셨습니다.\n\n"
                            f"📌 **해당 문제의 정답 목록**: {answers_str}",
                color=discord.Color.orange()
            )
            await message.channel.send(embed=embed)

            if quiz.current_question < quiz.total_questions:
                await send_next_quiz(message.channel, quiz)
            else:
                await message.channel.send(f"🎊 모든 퀴즈({quiz.total_questions}문제)가 끝났습니다!")
                del active_quizzes[channel_id]
            return

        # 정답 입력 처리
        if content in quiz.valid_answers:
            answers_str = ", ".join([f"`{a}`" for a in quiz.valid_answers])
            embed = discord.Embed(
                title="🎉 정답입니다!",
                description=f"**{message.author.mention}**님이 정답({content})을 맞히셨습니다!\n\n"
                            f"📌 **모든 정답 목록**: {answers_str}",
                color=discord.Color.green()
            )
            await message.channel.send(embed=embed)

            if quiz.current_question < quiz.total_questions:
                await send_next_quiz(message.channel, quiz)
            else:
                await message.channel.send(f"🎊 모든 퀴즈({quiz.total_questions}문제)가 끝났습니다!")
                del active_quizzes[channel_id]
            return

    # --- 7. 실제 게임 단어 입력 감지 ---
    if channel_id in active_games:
        game = active_games[channel_id]
        if game.is_started and message.author in game.players:
            # ★ 자기 차례가 아닌 플레이어가 말했을 때는 완전히 무시
            current_player = game.get_current_player()
            if message.author != current_player:
                return

            # 띄어쓰기가 포함된 문장은 무시
            if ' ' in content:
                return

            # ★ [단어장 검증] 모드에 맞춰 words3.txt 또는 words.txt 사용
            if getattr(game, 'mode', 'normal') == "words3_mode":
                valid_words = load_words3()
            else:
                valid_words = load_all_words()

            if content not in valid_words:
                await message.channel.send(f"❌ **{message.author.mention} 실패!** **`{content}`**은(는) 단어장에 등록되지 않은 단어입니다!")
                return

            # ★ [중복 단어 검증] 이미 기보에 사용된 단어 사용 불가
            if content in game.chain_history:
                await message.channel.send(f"❌ **{message.author.mention} 실패!** **`{content}`**은(는) 이미 사용된 단어입니다!")
                return

            prev_word = game.chain_history[-1]
            user_id = message.author.id

            # 직전 단어와 자음/모음 중복 검사 (첫 번째 단어 입력 시에도 무작위 제시어 단어와 중복 검사)
            if not check_no_overlap(prev_word, content):
                prev_jamo = ", ".join(sorted(list(extract_phonemes(prev_word))))
                curr_jamo = ", ".join(sorted(list(extract_phonemes(content))))
                await message.channel.send(
                    f"❌ **{message.author.mention} 실패!**\n"
                    f"'{prev_word}'({prev_jamo})와 '{content}'({curr_jamo})에 겹치는 자음/모음이 있습니다!"
                )
                return

            # 점수 계산 (음절 수)
            word_len = len(content)
            base_score = word_len
            bonus_score = 0

            # 9글자 이상 보너스 (+1, +2, +3 ...)
            if word_len >= 9:
                game.bonus_tracker[user_id] += 1
                bonus_score = game.bonus_tracker[user_id]

            total_gained = base_score + bonus_score
            game.scores[user_id] += total_gained
            game.chain_history.append(content)

            current_chains = len(game.chain_history) - 1
            total_user_score = game.scores[user_id]  # 해당 유저의 누적 총점

            # 실시간 흐름(기보) 텍스트 생성 (A ➔ B ➔ C)
            history_flow = " ➔ ".join(game.chain_history)

            # 다음 차례로 이동
            game.next_turn()
            next_player = game.get_current_player()

            bonus_text = f" (보너스 +{bonus_score}점! 🎉)" if bonus_score > 0 else ""
            await message.channel.send(
                f"✅ **{message.author.display_name}**: `{content}` ({word_len}글자) 입력 성공! "
                f"**+{total_gained}점**{bonus_text} (총 **{total_user_score}점**) | 현재 **{current_chains}/{game.max_chains} 체인**\n"
                f"📜 **기보**: `{history_flow}`\n"
                f"👉 **다음 차례:** {next_player.mention}"
            )

            # 최대 체인(n * 50) 도달 시 게임 종료
            if current_chains >= game.max_chains:
                await finish_game(message.channel, game, reason_title="🏁 최대 체인 달성! 게임 종료!")

